    const { isListening, startListening, stopListening, speak } = useWingmanVoice(onTranscript);

    // Auto-speak when a new response arrives
    useEffect(() => {
        if (lastResponse && import.meta.env.VITE_WINGMAN_VOICE_ENABLED === 'true') {
            speak(lastResponse);
