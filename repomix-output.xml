        }
    }
    else if (topic === 'SYSCALL_EVENT') {
        console.log(`[👁️] NATIVE SYSCALL EVENT: PID ${payload.pid} invoked ${payload.syscall}`);
        try {
            const mlRes = await axios.post(GNN_ORACLE_URL, { 
