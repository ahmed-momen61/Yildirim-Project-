const crypto = require('crypto');const ENCRYPTION_KEY = process.env.ENCRYPTION_KEY;const IV_LENGTH = 16;const encryptPayload = (text) => {    try {        const iv = crypto.randomBytes(IV_LENGTH);        const cipher = crypto.createCipheriv('aes-256-cbc', Buffer.from(ENCRYPTION_KEY, 'hex'), iv);        let encrypted = cipher.update(text);        encrypted = Buffer.concat([encrypted, cipher.final()]);        return iv.toString('hex') + ':' + encrypted.toString('hex');    } catch (error) {        console.error("[-] Encryption Error:", error.message);        return null;    }};const decryptPayload = (text) => {    try {        const textParts = text.split(':');        const iv = Buffer.from(textParts.shift(), 'hex');        const encryptedText = Buffer.from(textParts.join(':'), 'hex');        const decipher = crypto.createDecipheriv('aes-256-cbc', Buffer.from(ENCRYPTION_KEY, 'hex'), iv);        let decrypted = decipher.update(encryptedText);        decrypted = Buffer.concat([decrypted, decipher.final()]);        return decrypted.toString();    } catch (error) {        console.error("[-] Decryption Error:", error.message);        return null;    }};module.exports = {    encryptPayload,    decryptPayload};
</file>

