        process.exit(1);
    }

    const runtime = initializeRuntime(redisClient);
    const redTeam = runtime.getAgent('RedTeamOrchestrator');
    
    if (!redTeam) {
        console.error(`[❌] RedTeamOrchestrator not found in runtime. Exiting.`);
        process.exit(1);
