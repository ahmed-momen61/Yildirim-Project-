const crypto = require('crypto');const fs = require('fs');const generateSwarmKeys = () => {    if (!fs.existsSync('./swarm_private.pem') || !fs.existsSync('./swarm_public.pem')) {        const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', {            modulusLength: 2048,            publicKeyEncoding: { type: 'spki', format: 'pem' },            privateKeyEncoding: { type: 'pkcs8', format: 'pem' }        });        fs.writeFileSync('./swarm_private.pem', privateKey);        fs.writeFileSync('./swarm_public.pem', publicKey);        console.log('[🐝] Swarm Keys generated securely.');    }};const signSwarmPayload = (features) => {    const privateKey = fs.readFileSync('./swarm_private.pem', 'utf8');    const signer = crypto.createSign('sha256');    signer.update(JSON.stringify(features));    signer.end();    return signer.sign(privateKey, 'hex');};const verifySwarmPayload = (features, signature) => {    try {        const publicKey = fs.readFileSync('./swarm_public.pem', 'utf8');        const verifier = crypto.createVerify('sha256');        verifier.update(JSON.stringify(features));        verifier.end();        return verifier.verify(publicKey, signature, 'hex');    } catch (e) {        return false;    }};generateSwarmKeys();module.exports = { signSwarmPayload, verifySwarmPayload };
</file>

