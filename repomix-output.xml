                                border: msg.role === 'error' ? '1px solid rgba(239,68,68,0.3)' : 'none'
                            }}>
                                {msg.content}
                            </div>
                        ))}

                        {/* Active tool badges */}
                        {activeTools.length > 0 && (
                            <div style={{ display: 'flex', gap: '6px', flexWrap: 'wrap' }}>
                                {activeTools.map((tool, i) => (
                                    <span key={i} style={{
