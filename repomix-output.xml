      } catch (e) {        }    } catch (e) {        console.error(`[-] FAISS Store Error: ${e.message}`);    }};const findSimilarMitigation = async (currentAlertContext) => {    const vector = await generateEmbedding(currentAlertContext);    if (!vector || faissIndex.ntotal() === 0) return null;    try {        const results = faissIndex.search(vector, 1);        if (results && results.distances && results.distances.length > 0) {            const distance = results.distances[0];            if (distance < 50) {                const storedMitigation = memoryRegistry.get(results.labels[0]);                if (storedMitigation && storedMitigation.actionTaken) {                    return { ...storedMitigation, similarity: Math.max(0, 1 - distance / 100) };                }            }        }        return null;    } catch (e) {        console.error(`[-] FAISS Search Error: ${e.message}`);        return null;    }};module.exports = {    findSimilarIncidents,    saveIncidentToMemory,    publishLiveEvent,    redisClient,    publishAgentEvent,    getRecentAgentEvents,    saveAgentMemoryVector,    semanticAgentSearch,    saveMitigationStrategy,    findSimilarMitigation};
