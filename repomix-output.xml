        fs.writeFileSync(scriptPath, trainingScript);
        console.log(`[🧠] Training script generated: ${scriptPath}`);
        console.log(`[🧠] Config generated: ${configPath}`);
        const trainingRecord = {
            id: crypto.randomBytes(4).toString('hex'),
