        this.updateCycle();
        this.timer = setInterval(() => this.updateCycle(), this.intervalMs);
    }
    stop() {
        if (this.timer) {
            clearInterval(this.timer);
            this.timer = null;
            console.log('[🧠] eBPF Weight Updater stopped.');
        }
    }
    async updateCycle() {
        try {
            console.log('[🧠] Fetching latest LoRA weights for eBPF injection...');
