                const connection = await Connection.connect();
                const client = new Client({ connection });
                await client.workflow.start('pentestPipeline', {
                    taskQueue: 'bayezid-ir',
                    workflowId: `dynamic-playbook-${alertId}-${Date.now()}`,
                    args: [{
