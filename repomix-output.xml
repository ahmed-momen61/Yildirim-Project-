          )}
        </div>
        <div className="flex items-center justify-between text-xs">
          <div className="flex items-center gap-2 text-slate-400">
            <Database size={14} />
            {!collapsed && <span>Database</span>}
          </div>
          {!collapsed && <span className="text-emerald-400 font-mono">ONLINE</span>}
        </div>
      </div>
    </div>
  );
}
