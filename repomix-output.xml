    for (const key of Object.keys(daemons)) {
        spawnDaemon(key);
    }
};

const getCausalEngineStatus = () => {
    const status = {};
    for (const [key, daemon] of Object.entries(daemons)) {
        status[key] = {
            running: daemon.process !== null,
            pid: daemon.process ? daemon.process.pid : null,
            name: daemon.name,
