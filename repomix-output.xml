const PIPELINE_MODE = Object.freeze({
        SEQUENTIAL: 'SEQUENTIAL',
        FAN_OUT: 'FAN_OUT',
        HIERARCHICAL: 'HIERARCHICAL',
});

const AGENT_STATE = Object.freeze({
    IDLE: 'IDLE',
    EXECUTING: 'EXECUTING',
    REFLECTING: 'REFLECTING',
    WAITING_HITL: 'WAITING_HITL',
    CIRCUIT_OPEN: 'CIRCUIT_OPEN',
